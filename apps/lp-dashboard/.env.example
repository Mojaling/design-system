# 이 파일을 복사해서 같은 폴더에 .env 라는 이름으로 저장하고 값을 채우세요.
# .env는 git에 올라가지 않습니다. 키를 절대 공유하지 마세요.

# Alchemy API 키 (https://dashboard.alchemy.com 에서 무료로 발급)
# 앱을 만들 때 Ethereum, Base, BNB Smart Chain, Robinhood 네트워크를 켜 두세요.
ALCHEMY_API_KEY=your-alchemy-api-key

# 대시보드 주소 포트 (기본 4747 → http://127.0.0.1:4747)
# PORT=4747

# 탭이 보일 때 값을 새로 읽는 간격(ms). 짧을수록 CU를 많이 씁니다.
# POLL_INTERVAL_MS=2000

# 조회할 체인만 고르기 (쉼표로 구분: eth,base,bsc,robinhood). 비우면 전부.
# ENABLED_CHAINS=base,bsc

# 슬러그가 다르거나 다른 RPC를 쓰고 싶을 때 체인별로 덮어쓰기
# RPC_URL_ROBINHOOD=https://...
# WS_URL_ROBINHOOD=wss://...
# NFT_API_URL_ROBINHOOD=https://.../nft/v3/...

# 1로 두면 RPC 없이 가짜 데이터로 화면만 띄웁니다 (데모 모드)
# MOCK=1
